<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>أبيكس للاستشارات الإدارية وتطوير الأعمال</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Tajawal', sans-serif; }
  </style>
</head>
<body class="bg-slate-900 text-slate-100 antialiased">

  <!-- Header -->
  <header class="border-b border-slate-800 bg-slate-900/80 backdrop-blur sticky top-0 z-50">
    <div class="max-w-6xl mx-auto px-6 h-20 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <div class="w-10 h-10 rounded-xl bg-blue-600 flex items-center justify-center font-bold text-xl text-white">A</div>
        <span class="text-xl font-extrabold tracking-tight">APEX <span class="text-blue-500">CONSULTING</span></span>
      </div>
      <nav class="hidden md:flex gap-8 text-sm font-medium text-slate-400">
        <a href="#services" class="hover:text-white transition">الخدمات</a>
        <a href="#stats" class="hover:text-white transition">الإنجازات</a>
        <a href="#contact" class="hover:text-white transition">تواصل معنا</a>
      </nav>
      <a href="#contact" class="px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-medium text-sm transition">حجز استشارة</a>
    </div>
  </header>

  <!-- Hero Section -->
  <section class="max-w-6xl mx-auto px-6 py-24 text-center">
    <span class="px-4 py-1.5 rounded-full bg-blue-500/10 text-blue-400 text-sm font-semibold border border-blue-500/20 inline-block mb-6">شريكك الاستراتيجي للنمو الرقمي</span>
    <h1 class="text-4xl md:text-6xl font-extrabold text-white leading-tight mb-6">
      نحوّل استراتيجيات أعمالك إلى <br class="hidden md:block"><span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-cyan-300">أرباح ونمو مستدام</span>
    </h1>
    <p class="text-slate-400 text-lg md:text-xl max-w-2xl mx-auto mb-10 leading-relaxed">
      نقدم حلولاً استشارية متكاملة للشركات الناشئة والمؤسسات لتطوير الكفاءة التشغيلية، التحول الرقمي، وتعظيم الإيرادات.
    </p>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href="#contact" class="w-full sm:w-auto px-8 py-4 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-bold transition">ابدأ مشروعك الآن</a>
      <a href="#services" class="w-full sm:w-auto px-8 py-4 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold border border-slate-700 transition">استكشف الخدمات</a>
    </div>
  </section>

  <!-- Stats -->
  <section id="stats" class="border-y border-slate-800 bg-slate-800/40 py-16">
    <div class="max-w-6xl mx-auto px-6 grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
      <div>
        <div class="text-3xl md:text-5xl font-extrabold text-blue-400 mb-2">+120</div>
        <div class="text-sm text-slate-400 font-medium">مشروع استشاري منجز</div>
      </div>
      <div>
        <div class="text-3xl md:text-5xl font-extrabold text-cyan-400 mb-2">98%</div>
        <div class="text-sm text-slate-400 font-medium">نسبة رضا العملاء</div>
      </div>
      <div>
        <div class="text-3xl md:text-5xl font-extrabold text-blue-400 mb-2">3.5x</div>
        <div class="text-sm text-slate-400 font-medium">متوسط نمو الأرباح</div>
      </div>
      <div>
        <div class="text-3xl md:text-5xl font-extrabold text-cyan-400 mb-2">+10</div>
        <div class="text-sm text-slate-400 font-medium">سنوات خبرة بالسوق</div>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section id="services" class="max-w-6xl mx-auto px-6 py-24">
    <div class="text-center mb-16">
      <h2 class="text-3xl font-bold mb-4">خدمات استشارية تصنع الفارق</h2>
      <p class="text-slate-400">حلول مخصصة تضمن التفوق على المنافسين في السوق الرقمي</p>
    </div>
    <div class="grid md:grid-cols-3 gap-8">
      <div class="p-8 rounded-2xl bg-slate-800/60 border border-slate-700/60 hover:border-blue-500/50 transition">
        <div class="w-12 h-12 rounded-xl bg-blue-500/10 text-blue-400 flex items-center justify-center text-2xl mb-6">📈</div>
        <h3 class="text-xl font-bold mb-3">التخطيط الاستراتيجي</h3>
        <p class="text-slate-400 text-sm leading-relaxed">دراسة دقيقة لحالة السوق وتحديد الفرص الواعدة لبناء خارطة طريق واضحة وقابلة للتنفيذ.</p>
      </div>
      <div class="p-8 rounded-2xl bg-slate-800/60 border border-slate-700/60 hover:border-blue-500/50 transition">
        <div class="w-12 h-12 rounded-xl bg-cyan-500/10 text-cyan-400 flex items-center justify-center text-2xl mb-6">⚡</div>
        <h3 class="text-xl font-bold mb-3">التحول الرقمي</h3>
        <p class="text-slate-400 text-sm leading-relaxed">أتمتة العمليات ودمج أحدث الأدوات التقنية لرفع الإنتاجية وتقليل التكاليف التشغيلية.</p>
      </div>
      <div class="p-8 rounded-2xl bg-slate-800/60 border border-slate-700/60 hover:border-blue-500/50 transition">
        <div class="w-12 h-12 rounded-xl bg-blue-500/10 text-blue-400 flex items-center justify-center text-2xl mb-6">💼</div>
        <h3 class="text-xl font-bold mb-3">هيكلة وتطوير المبيعات</h3>
        <p class="text-slate-400 text-sm leading-relaxed">إعادة هندسة مسارات البيع وتدريب الفرق الميدانية على أساليب الإغلاق الفعالة.</p>
      </div>
    </div>
  </section>

  <!-- Contact Form -->
  <section id="contact" class="max-w-3xl mx-auto px-6 pb-24">
    <div class="p-8 md:p-12 rounded-3xl bg-slate-800/80 border border-slate-700">
      <h3 class="text-2xl font-bold text-center mb-2">احجز جلسة استشارية أولية مجاناً</h3>
      <p class="text-slate-400 text-center text-sm mb-8">سيتواصل معك مستشارنا المختص خلال 24 ساعة</p>
      <form class="space-y-4">
        <div>
          <label class="block text-xs font-semibold text-slate-400 mb-2">الاسم بالكامل</label>
          <input type="text" placeholder="محمد السعيد" class="w-full px-4 py-3 rounded-xl bg-slate-900 border border-slate-700 text-white focus:outline-none focus:border-blue-500 text-sm">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-400 mb-2">البريد الإلكتروني أو رقم الهاتف</label>
          <input type="text" placeholder="example@mail.com" class="w-full px-4 py-3 rounded-xl bg-slate-900 border border-slate-700 text-white focus:outline-none focus:border-blue-500 text-sm">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-400 mb-2">نوع المشروع / التحدي الحالي</label>
          <textarea rows="3" placeholder="اكتب نبذة سريعة عن مشروعك..." class="w-full px-4 py-3 rounded-xl bg-slate-900 border border-slate-700 text-white focus:outline-none focus:border-blue-500 text-sm"></textarea>
        </div>
        <button type="button" class="w-full py-4 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-bold transition text-sm">إرسال الطلب</button>
      </form>
    </div>
  </section>

  <!-- Footer -->
  <footer class="border-t border-slate-800 py-8 text-center text-slate-500 text-sm">
    جميع الحقوق محفوظة © APEX Consulting
  </footer>

</body>
</html>

